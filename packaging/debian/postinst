#!/bin/sh
# Runs after the package's files are unpacked.
#
# Creates the unprivileged account the watchdog runs as, sets up the directories
# it owns, and schedules it. Enrolment is deliberately NOT done here: a package
# is identical for every machine and a device key is not, so it cannot carry
# one.
set -e

WATCHDOG_USER="sentinel"
INSTALL_DIR="/opt/sentinel-watchdog"
CONFIG_DIR="/etc/sentinel-watchdog"
STATE_DIR="/var/lib/sentinel-watchdog"
LOG_DIR="/var/log/sentinel-watchdog"
CRON_FILE="/etc/cron.d/sentinel-watchdog"
VERSION_FILE="$INSTALL_DIR/.packaged-version"

cron_is_running() {
    # pgrep is deliberately not used: it is missing from minimal images, and
    # where it exists it also matches a dead cron left as a zombie -- exactly
    # the case this check has to catch. /proc is always there.
    for comm in /proc/[0-9]*/comm; do
        [ -r "$comm" ] || continue
        case "$(cat "$comm" 2>/dev/null)" in
            cron|crond) ;;
            *) continue ;;
        esac
        # A container's main process is the application, not an init system,
        # so it never reaps its children: a cron that has exited stays in
        # /proc as a zombie and would otherwise read as running.
        stat_line=$(cat "${comm%comm}stat" 2>/dev/null) || continue
        state=${stat_line##*) }
        [ "${state%% *}" = "Z" ] && continue
        return 0
    done
    return 1
}

case "$1" in
    configure)
        if ! id "$WATCHDOG_USER" >/dev/null 2>&1; then
            adduser --system --no-create-home --group \
                --shell /usr/sbin/nologin "$WATCHDOG_USER" >/dev/null
        fi

        # Renamed from "sentinel-agent": carry an existing device's identity
        # across rather than leaving it orphaned under the old paths.
        if [ -d /etc/sentinel-agent ] && [ ! -e "$CONFIG_DIR" ]; then
            rm -f /etc/cron.d/sentinel-agent /usr/local/bin/sentinel-agent
            mv /etc/sentinel-agent "$CONFIG_DIR"
            [ -d /var/lib/sentinel-agent ] && [ ! -e "$STATE_DIR" ] && mv /var/lib/sentinel-agent "$STATE_DIR"
            [ -d /var/log/sentinel-agent ] && [ ! -e "$LOG_DIR" ] && mv /var/log/sentinel-agent "$LOG_DIR"
            [ -f "$STATE_DIR/agent.lock" ] && mv "$STATE_DIR/agent.lock" "$STATE_DIR/watchdog.lock"
            [ -f "$LOG_DIR/agent.log" ] && mv "$LOG_DIR/agent.log" "$LOG_DIR/watchdog.log"
            rm -rf /opt/sentinel-agent
        fi

        mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$LOG_DIR"
        chmod 750 "$CONFIG_DIR"
        chmod 700 "$STATE_DIR"
        chmod 750 "$LOG_DIR"
        chown "$WATCHDOG_USER:$WATCHDOG_USER" "$CONFIG_DIR" "$STATE_DIR" "$LOG_DIR"
        if [ -f "$CONFIG_DIR/config.json" ]; then
            chmod 600 "$CONFIG_DIR/config.json"
            chown "$WATCHDOG_USER:$WATCHDOG_USER" "$CONFIG_DIR/config.json"
        fi

        # Only live/ is writable by the watchdog. The install root and bin/ stay
        # root-owned, because write permission on a directory allows replacing
        # anything inside it -- a watchdog-writable root would let the watchdog
        # rewrite the launcher, which gets run as root by a reinstall.
        if [ -d "$INSTALL_DIR/live" ]; then
            chown -R "$WATCHDOG_USER:$WATCHDOG_USER" "$INSTALL_DIR/live"
        fi

        # Point `current` at the version this package shipped. A self-updated
        # machine being reinstalled is reset to the packaged version, which is
        # the behaviour you want from reinstalling a package.
        if [ -r "$VERSION_FILE" ]; then
            packaged=$(cat "$VERSION_FILE")
            if [ -d "$INSTALL_DIR/live/versions/$packaged" ]; then
                ln -sfn "versions/$packaged" "$INSTALL_DIR/live/current"
                chown -h "$WATCHDOG_USER:$WATCHDOG_USER" "$INSTALL_DIR/live/current"
            fi
        fi
        # A reinstall supersedes whatever an update was part-way through.
        rm -f "$STATE_DIR/pending_version.json"

        cat > "$CRON_FILE" <<EOF
# Sentinel watchdog. Managed by the sentinel-watchdog package.
# One entry: cron supplies the tick, the watchdog decides what is due, so the
# collection schedule stays changeable from the dashboard.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * $WATCHDOG_USER $INSTALL_DIR/bin/sentinel-watchdog --quiet beat
EOF
        chmod 644 "$CRON_FILE"

        # cron is a declared dependency so it is installed, but on a machine
        # with no init system -- a container -- nothing starts it.
        if ! cron_is_running; then
            if [ -d /run/systemd/system ]; then
                systemctl enable --now cron >/dev/null 2>&1 || true
            else
                cron >/dev/null 2>&1 || true
            fi
        fi

        if [ ! -f "$CONFIG_DIR/config.json" ]; then
            echo ""
            echo "sentinel-watchdog installed but not yet enrolled. Run:"
            echo "  sudo sentinel-watchdog enroll --server <url> --key <device key>"
            echo ""
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure) ;;
esac

exit 0
