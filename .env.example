# Copy to .env and edit. Never commit .env.

# ---- database ------------------------------------------------------------- #
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# ---- admin (seeded on first start only; ignored once an admin exists) ----- #
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# ---- URLs ----------------------------------------------------------------- #
# The address a managed device should report to. Baked into downloaded
# installers, so it must be reachable from the devices themselves -- not
# localhost, once you deploy to the VPS.
PUBLIC_API_URL=http://localhost:8000

# ---- ports ---------------------------------------------------------------- #
DASHBOARD_PORT=8501
API_PORT=8000

# ---- logging -------------------------------------------------------------- #
LOG_LEVEL=INFO

# ---- Liva (chat assistant) ------------------------------------------------ #
# Free key from https://console.groq.com. Without it the Liva tab explains that
# chat is not configured; the rest of Sentinel is unaffected.
GROQ_API_KEY=
# Any Groq model that supports tool calling.
LIVA_MODEL=llama-3.3-70b-versatile
