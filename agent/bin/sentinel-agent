#!/usr/bin/env python3
"""Entrypoint shim.

Adds the install root to sys.path so the agent package imports without being
pip-installed. This is what lets the installer work with nothing but python3
present on the device.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from sentinel_agent.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
